<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>بیماران — طبیب‌یار</title>
  <link rel="stylesheet" href="/css/style.css" />
  <% if (typeof csrfToken !== 'undefined') { %><meta name="csrf-token" content="<%= csrfToken %>" /><% } %>
</head>
<body>
  <%- include('partials/header', { section: 'patients' }) %>
  <main id="main-content">
    <section class="page-heading">
      <div><p class="eyebrow">پرونده‌ها</p><h1>بیماران</h1><p class="subtitle">جست‌وجو و دسترسی سریع به تاریخچهٔ درمان</p></div>
      <a class="button button-primary" href="/patients/new">+ بیمار جدید</a>
    </section>
    <form class="search-form" method="get" action="/patients">
      <input type="search" name="q" value="<%= query || '' %>" placeholder="جست‌وجو با نام یا شماره موبایل" aria-label="جست‌وجوی بیمار" />
      <button type="submit">جست‌وجو</button>
    </form>
    <% if (query) { %><p class="result-count"><%= patients.length %> نتیجه برای «<%= query %>»</p><% } %>

    <% if (!patients.length) { %>
      <p class="list-empty">هنوز بیماری ثبت نشده است.</p>
    <% } %>
    <ul class="patients-list">
      <% patients.forEach(function(p) { %>
        <li>
          <a href="/patients/<%= p.id %>">
            <strong><%= p.full_name %></strong>
            <div class="list-meta">
              موبایل: <%= p.phone %> —
              رضایت: <%= p.consent_recorded_at ? 'ثبت‌شده' : 'ثبت‌نشده' %>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>
  </main>
</body>
</html>
