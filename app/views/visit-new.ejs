<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ویزیت جدید — طبیب‌یار</title>
  <link rel="stylesheet" href="/css/style.css" />
  <% if (typeof csrfToken !== 'undefined') { %><meta name="csrf-token" content="<%= csrfToken %>" /><% } %>
</head>
<body>
  <%- include('partials/header', { section: 'visits-new' }) %>
  <main id="main-content">
    <section class="page-heading">
      <div><p class="eyebrow">مستندسازی سریع</p><h1>ثبت ویزیت جدید</h1><p class="subtitle">تخصص: <%= specialty %> · پیش‌نویس برای بازبینی شما ساخته می‌شود</p></div>
      <a href="/patients">جست‌وجوی بیمار</a>
    </section>

    <% if (!patients.length) { %>
      <p class="list-empty">هنوز بیماری ثبت نشده — ابتدا <a href="/patients/new">یک بیمار جدید</a> بسازید.</p>
    <% } else { %>
      <form method="post" action="/visits">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>بیمار
          <select name="patient_id" required>
            <% patients.forEach(function(p) { %>
              <option value="<%= p.id %>"><%= p.full_name %></option>
            <% }) %>
          </select>
        </label>
        <a href="/patients/new">+ بیمار جدید</a>

        <% if (templates.length) { %>
          <label>قالب ثبت ویزیت
            <select id="visit-template">
              <option value="">بدون قالب</option>
              <% templates.forEach(function(template, index) { %>
                <option value="<%= index %>" data-text="<%= template.text %>"><%= template.label %></option>
              <% }) %>
            </select>
          </label>
        <% } %>

        <label>خلاصهٔ ویزیت (متن آزاد — ورودی صوتی در نسخهٔ بعد از طریق آپلود/STT اضافه می‌شود)
          <textarea id="raw-input" name="raw_input" rows="8" required placeholder="مثلاً: بیمار دیابت نوع دو، قند ناشتا ۲۱۰ بود..."></textarea>
        </label>

        <button type="submit">ثبت و ارسال به پایپ‌لاین ساخت‌دهی</button>
      </form>
    <% } %>
  </main>
  <script src="/js/visit-new.js" defer></script>
</body>
</html>
