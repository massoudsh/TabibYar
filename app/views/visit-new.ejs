<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ویزیت جدید — طبیب‌یار</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/header') %>
  <main>
    <h1>ثبت خلاصهٔ ویزیت</h1>
    <p class="subtitle">تخصص: <%= specialty %></p>

    <% if (!patients.length) { %>
      <p class="list-empty">هنوز بیماری ثبت نشده — ابتدا <a href="/patients/new">یک بیمار جدید</a> بسازید.</p>
    <% } else { %>
      <form method="post" action="/visits">
        <label>بیمار
          <select name="patient_id" required>
            <% patients.forEach(function(p) { %>
              <option value="<%= p.id %>"><%= p.full_name %></option>
            <% }) %>
          </select>
        </label>
        <a href="/patients/new">+ بیمار جدید</a>

        <% if (templates.length) { %>
          <label>قالب ثبت ویزیت
            <select id="visit-template">
              <option value="">بدون قالب</option>
              <% templates.forEach(function(template, index) { %>
                <option value="<%= index %>"><%= template.label %></option>
              <% }) %>
            </select>
          </label>
        <% } %>

        <label>خلاصهٔ ویزیت (متن آزاد — ورودی صوتی در نسخهٔ بعد از طریق آپلود/STT اضافه می‌شود)
          <textarea id="raw-input" name="raw_input" rows="8" required placeholder="مثلاً: بیمار دیابت نوع دو، قند ناشتا ۲۱۰ بود..."></textarea>
        </label>

        <button type="submit">ثبت و ارسال به پایپ‌لاین ساخت‌دهی</button>
      </form>
    <% } %>
  </main>
  <% if (templates.length) { %>
    <script>
      const templates = <%- JSON.stringify(templates) %>;
      document.getElementById('visit-template').addEventListener('change', (event) => {
        const template = templates[event.target.value];
        if (template) document.getElementById('raw-input').value = template.text;
      });
    </script>
  <% } %>
</body>
</html>
