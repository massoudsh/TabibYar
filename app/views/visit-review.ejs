<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>بازبینی ویزیت — طبیب‌یار</title>
  <link rel="stylesheet" href="/css/style.css" />
  <% if (typeof csrfToken !== 'undefined') { %><meta name="csrf-token" content="<%= csrfToken %>" /><% } %>
</head>
<body>
  <%- include('partials/header') %>
  <main id="main-content" class="glass-strong card">
    <h1>بازبینی پیش‌نویس ویزیت</h1>
    <p class="subtitle">
      وضعیت: <span class="status-badge" data-status="<%= visit.status %>"><%= visit.status %></span>
    </p>

    <%- include('partials/disclaimer', { text: disclaimer }) %>

    <details>
      <summary>متن خام ثبت‌شده توسط پزشک</summary>
      <p><%= visit.raw_input %></p>
    </details>

    <% if (changesSincePrevious.hasPrevious) { %>
      <section class="changes-box">
        <h2>خلاصهٔ تغییرات از ویزیت قبلی</h2>
        <% if (changesSincePrevious.recurringComplaints.length) { %>
          <p>شکایت‌های تکرارشونده: <%= changesSincePrevious.recurringComplaints.join('، ') %></p>
        <% } %>
        <% if (changesSincePrevious.medicationsAdded.length) { %>
          <p>داروهای جدید: <%= changesSincePrevious.medicationsAdded.join('، ') %></p>
        <% } %>
        <% if (changesSincePrevious.medicationsStopped.length) { %>
          <p>داروهای قطع‌شده: <%= changesSincePrevious.medicationsStopped.join('، ') %></p>
        <% } %>
      </section>
    <% } %>

    <% if (!visit.ai_draft) { %>
      <section id="draft-progress" data-visit-id="<%= visit.id %>">
        <p role="status" aria-live="polite">پیش‌نویس در حال پردازش است؛ پس از آماده‌شدن خودکار نمایش داده می‌شود.</p>
        <button type="button" id="retry-draft" hidden>تلاش دوباره</button>
      </section>
    <% } else { %>
      <% const d = visit.status === 'approved' ? visit.approved_content : visit.ai_draft; %>
      <% if (d.missing_or_ambiguous && d.missing_or_ambiguous.length) { %>
        <div class="warning-box">
          <strong>موارد مبهم/ناقص (نیازمند تکمیل پزشک):</strong>
          <ul><% d.missing_or_ambiguous.forEach(function(m){ %><li><%= m %></li><% }) %></ul>
        </div>
      <% } %>

      <% if (visit.rag_insights && visit.rag_insights.insights && visit.rag_insights.insights.length) { %>
        <section class="rag-box">
          <h2>نکات مرتبط از پایگاه دانش (دستیار RAG)</h2>
          <p class="rag-disclaimer">این نکات صرفاً یادآوری/مستندسازی است، نه تشخیص یا تجویز — تصمیم نهایی با پزشک است.</p>
          <ul>
            <% visit.rag_insights.insights.forEach(function(i) { %>
              <li><%= i.note %> <span class="rag-source">— منبع: <%= i.sourceHeading %></span></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <form id="draft-form" data-visit-id="<%= visit.id %>" data-original="<%= JSON.stringify(d) %>">
        <fieldset <%= visit.status === 'approved' ? 'disabled' : '' %>>
        <legend>محتوای ویزیت</legend>
        <label>شرح‌حال (history)
          <textarea name="history" rows="3"><%= d.history %></textarea>
        </label>
        <label>یافته‌ها (findings)
          <textarea name="findings" rows="2"><%= d.findings %></textarea>
        </label>
        <label class="ddx-label">
          تشخیص‌های احتمالی <span class="badge-draft" title="<%= ddxDisclaimer %>">پیش‌نویس</span>
          <textarea name="differential_diagnosis_draft" rows="2"><%= (d.differential_diagnosis_draft || []).join('\n') %></textarea>
        </label>
        <label>برنامهٔ درمان (treatment_plan)
          <textarea name="treatment_plan" rows="2"><%= d.treatment_plan %></textarea>
        </label>
        <section data-editor="medications" aria-label="داروها">
          <h2>داروها</h2>
          <div data-rows>
            <% (d.medications || []).forEach(function(item) { %>
              <div data-row>
                <label>نام دارو<textarea data-field="name" required dir="auto"><%= item.name %></textarea></label>
                <label>دوز<textarea data-field="dosage" dir="auto"><%= item.dosage || '' %></textarea></label>
                <label>دستور مصرف<textarea data-field="instructions" dir="auto"><%= item.instructions || '' %></textarea></label>
                <button type="button" data-remove>حذف دارو</button>
              </div>
            <% }) %>
          </div>
          <button type="button" data-add>افزودن دارو</button>
        </section>
        <label>خلاصه برای بیمار (patient_summary)
          <textarea name="patient_summary" rows="3"><%= d.patient_summary %></textarea>
        </label>
        <label>هشدارها — یک مورد در هر خط
          <textarea name="warnings" rows="2"><%= (d.warnings||[]).join('\n') %></textarea>
        </label>
        <section data-editor="follow_up" aria-label="پیگیری‌ها">
          <h2>پیگیری‌ها</h2>
          <div data-rows>
            <% (d.follow_up || []).forEach(function(item) { %>
              <div data-row>
                <label>شرح پیگیری<textarea data-field="description" required dir="auto"><%= item.description %></textarea></label>
                <label>زمان پیشنهادی<textarea data-field="due_hint" dir="auto"><%= item.due_hint || '' %></textarea></label>
                <button type="button" data-remove>حذف پیگیری</button>
              </div>
            <% }) %>
          </div>
          <button type="button" data-add>افزودن پیگیری</button>
        </section>

        <button type="button" id="save-draft" class="btn-secondary">ذخیرهٔ ویرایش</button>
        <button type="button" id="approve-btn">تأیید نهایی پزشک</button>
        </fieldset>
        <p id="save-status" role="status" aria-live="polite"></p>
      </form>

      <% if (visit.status === 'approved') { %>
        <form method="post" action="/visits/<%= visit.id %>/send-sms">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit">ارسال خلاصه به بیمار (پیامک)</button>
        </form>
      <% } %>

      <section class="rag-ask-box">
        <h2>پرسش از دستیار هوشمند</h2>
        <p class="rag-disclaimer">فقط برای مستندسازی و یادآوری مبتنی بر پایگاه دانش داخلی — تشخیص یا تجویز نمی‌دهد.</p>
        <form id="rag-ask-form" data-visit-id="<%= visit.id %>">
          <textarea name="question" rows="2" placeholder="مثلاً: برای پیگیری دیابت چه مواردی را باید حتماً ثبت کنم؟"></textarea>
          <button type="submit">پرسیدن</button>
        </form>
        <div id="rag-answer" class="rag-answer" hidden></div>
      </section>
    <% } %>
  </main>
  <script src="/js/review.js"></script>
  <script src="/js/draft-progress.js"></script>
  <script src="/js/rag-assistant.js"></script>
</body>
</html>
