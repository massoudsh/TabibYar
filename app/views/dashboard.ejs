<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>داشبورد — طبیب‌یار</title>
  <link rel="stylesheet" href="/css/style.css" />
  <% if (typeof csrfToken !== 'undefined') { %><meta name="csrf-token" content="<%= csrfToken %>" /><% } %>
</head>
<body>
  <%- include('partials/header', { section: 'dashboard' }) %>
  <main id="main-content" class="dashboard-page">
    <section class="welcome-row">
      <div>
        <p class="eyebrow">فضای کاری پزشک</p>
        <h1>صبح بخیر، آمادهٔ ویزیت هستید؟</h1>
        <p class="subtitle">کارهای مهم امروز را از همین‌جا ادامه دهید.</p>
      </div>
      <a class="button button-primary" href="/visits/new">+ ثبت ویزیت جدید</a>
    </section>

    <section class="summary-grid" aria-label="خلاصهٔ عملکرد">
      <a class="glass glass-interactive summary-card summary-card-primary" href="/visits/new">
        <span class="summary-icon">＋</span>
        <span class="summary-label">ویزیت امروز</span>
        <strong><%= summary.today_visits %></strong>
        <span class="summary-link">ثبت ویزیت</span>
      </a>
      <a class="glass glass-interactive summary-card" href="/visits/new">
        <span class="summary-icon">◌</span>
        <span class="summary-label">در انتظار بازبینی</span>
        <strong><%= summary.pending_reviews %></strong>
        <span class="summary-link">مشاهدهٔ پیش‌نویس‌ها</span>
      </a>
      <a class="glass glass-interactive summary-card" href="/follow-ups">
        <span class="summary-icon">✓</span>
        <span class="summary-label">پیگیری باز</span>
        <strong><%= summary.open_follow_ups %></strong>
        <span class="summary-link">مدیریت پیگیری‌ها</span>
      </a>
      <a class="glass glass-interactive summary-card" href="/patients">
        <span class="summary-icon">♡</span>
        <span class="summary-label">کل بیماران</span>
        <strong><%= summary.patients_count %></strong>
        <span class="summary-link">جست‌وجوی پرونده</span>
      </a>
    </section>

    <section class="glass dashboard-panel trend-panel" aria-labelledby="trend-heading">
      <div class="panel-heading">
        <div><p class="eyebrow">۱۴ روز اخیر</p><h2 id="trend-heading">روند ویزیت و تأیید</h2></div>
        <ul class="chart-legend" aria-hidden="true">
          <li><span class="legend-swatch legend-visits"></span>ویزیت</li>
          <li><span class="legend-swatch legend-approved"></span>تأییدشده</li>
        </ul>
      </div>
      <div class="bar-chart" role="img" aria-label="نمودار ستونی ویزیت‌های ثبت‌شده و تأییدشده در ۱۴ روز اخیر">
        <% trend.forEach(function(point) { %>
          <div class="bar-group">
            <div class="bar-stack">
              <span class="bar bar-visits" style="--bar-height: <%= Math.round((point.visits / trendMax) * 100) %>%" title="<%= toJalaliString(point.day) %>: <%= point.visits %> ویزیت"></span>
              <span class="bar bar-approved" style="--bar-height: <%= Math.round((point.approved / trendMax) * 100) %>%" title="<%= toJalaliString(point.day) %>: <%= point.approved %> تأیید"></span>
            </div>
            <span class="bar-value"><%= point.visits %></span>
            <span class="bar-label"><%= toJalaliString(point.day, { day: 'numeric', month: 'numeric' }) %></span>
          </div>
        <% }) %>
      </div>
      <table class="visually-hidden">
        <caption>دادهٔ نمودار روند ۱۴ روز اخیر</caption>
        <thead><tr><th scope="col">روز</th><th scope="col">ویزیت</th><th scope="col">تأییدشده</th></tr></thead>
        <tbody>
          <% trend.forEach(function(point) { %>
            <tr><th scope="row"><%= toJalaliString(point.day) %></th><td><%= point.visits %></td><td><%= point.approved %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <section class="dashboard-columns">
      <div class="glass dashboard-panel">
        <div class="panel-heading"><div><p class="eyebrow">کارهای بعدی</p><h2>پیگیری‌های باز</h2></div><a href="/follow-ups">همه</a></div>
        <% if (!followUps.length) { %><div class="empty-state"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.6 2.6L16 9.5"/></svg><p>همهٔ پیگیری‌ها انجام شده‌اند.</p></div><% } %>
        <ul class="compact-list">
          <% followUps.forEach(function(item) { %>
            <li><a href="/patients/<%= item.patient_id %>"><strong><%= item.description %></strong><span><%= item.patient_name %><% if (item.due_date) { %> · <%= new Date(item.due_date).toLocaleDateString('fa-IR') %><% } %></span></a></li>
          <% }) %>
        </ul>
      </div>
      <div class="glass dashboard-panel">
        <div class="panel-heading"><div><p class="eyebrow">آخرین فعالیت</p><h2>ویزیت‌های اخیر</h2></div><a href="/patients">بیماران</a></div>
        <ul class="compact-list">
          <% recentVisits.forEach(function(visit) { %>
            <li><a href="/visits/<%= visit.id %>/review"><strong><%= visit.patient_name %></strong><span><%= new Date(visit.visit_date).toLocaleDateString('fa-IR') %> · <span class="status-badge" data-status="<%= visit.status %>"><%= visit.status === 'approved' ? 'تأییدشده' : 'نیازمند بازبینی' %></span></span></a></li>
          <% }) %>
        </ul>
      </div>
    </section>
  </main>
</body>
</html>
