<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>پیگیری‌ها — طبیب‌یار</title>
  <link rel="stylesheet" href="/css/style.css" />
  <% if (typeof csrfToken !== 'undefined') { %><meta name="csrf-token" content="<%= csrfToken %>" /><% } %>
</head>
<body>
  <%- include('partials/header', { section: 'follow-ups' }) %>
  <main id="main-content">
    <section class="page-heading">
      <div><p class="eyebrow">مراقبت مستمر</p><h1>پیگیری‌ها</h1><p class="subtitle">اقدام‌های بعدی بیماران را فراموش نکنید؛ می‌توانید پیامک یادآوری هم زمان‌بندی کنید.</p></div>
      <a class="button button-secondary" href="/visits/new">ثبت ویزیت</a>
    </section>
    <% if (!followUps.length) { %>
      <p class="list-empty">پیگیری‌ای برای نمایش وجود ندارد.</p>
    <% } %>
    <ul class="follow-up-list">
      <% followUps.forEach(function(item) { %>
        <li class="follow-up-item <%= item.status === 'done' ? 'is-complete' : '' %>">
          <div>
            <strong><%= item.description %></strong>
            <div class="list-meta">
              بیمار: <a href="/patients/<%= item.patient_id %>"><%= item.patient_name %></a>
              <% if (item.due_date) { %> — موعد: <%= new Date(item.due_date).toLocaleDateString('fa-IR') %><% } %>
            </div>
          </div>
          <% if (item.status === 'pending') { %>
            <form method="post" action="/follow-ups/<%= item.id %>/complete">
              <button type="submit">تکمیل شد</button>
            </form>
            <details class="reminder-form">
              <summary>زمان‌بندی پیامک</summary>
              <form method="post" action="/follow-ups/<%= item.id %>/reminders">
                <label>زمان ارسال
                  <input type="datetime-local" name="scheduled_for" required />
                </label>
                <label>متن یادآوری
                  <input name="message" maxlength="480" required />
                </label>
                <button type="submit">ثبت یادآوری</button>
              </form>
            </details>
          <% } else { %>
            <span class="status-badge" data-status="approved">تکمیل‌شده</span>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </main>
</body>
</html>
