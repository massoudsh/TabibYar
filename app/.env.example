# کپی کنید به .env و مقداردهی کنید — .env هرگز commit نمی‌شود.

# دیتابیس اصلی (ایشو #12/#13)
DATABASE_URL=postgres://user:password@localhost:5432/tabibyar
PG_POOL_MAX=10

# احراز هویت (ایشو #9)
JWT_SECRET=change-me-to-a-long-random-string

# رمزنگاری در حالت ذخیره (ایشو #14) — با:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# لایهٔ ساخت‌دهی/LLM (ایشو #1/#3/#4)
MODEL_PROVIDER=mock        # mock | openai
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# STT فارسی (ایشو #2) — بعد از انتخاب سرویس طبق docs/research/stt-vendor-comparison.md
STT_PROVIDER=mock          # mock | http
STT_API_URL=
STT_API_KEY=

# پیامک (ایشو #16/#17/#18) — بعد از انتخاب سرویس طبق docs/research/sms-vendor-comparison.md
SMS_PROVIDER=mock          # mock | kavenegar | ippanel
SMS_API_KEY=
SMS_SENDER=

# صف پردازش (ایشو #6)
QUEUE_POLL_INTERVAL_MS=2000

PORT=3000
NODE_ENV=development
