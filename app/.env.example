# کپی کنید به .env و مقداردهی کنید — .env هرگز commit نمی‌شود.

# دیتابیس اصلی (ایشو #12/#13)
DATABASE_URL=postgres://user:password@localhost:5432/tabibyar
PG_POOL_MAX=10

# احراز هویت (ایشو #9)
JWT_SECRET=change-me-to-a-long-random-string

# رمزنگاری در حالت ذخیره (ایشو #14) — با:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# لایهٔ ساخت‌دهی/LLM (ایشو #1/#3/#4)
MODEL_PROVIDER=mock        # mock | openai
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# STT فارسی (ایشو #2) — طبق docs/research/stt-vendor-comparison.md
# گزینهٔ خودمیزبان: stt-service/ (مدل Paulwalker4884/whisper-persian — راه‌اندازی: stt-service/README.md)
STT_PROVIDER=mock          # mock | http
STT_API_URL=               # مثال با stt-service محلی: http://localhost:8000/transcribe
STT_API_KEY=

# پیامک (ایشو #16/#17/#18) — سرویس نهایی انتخاب‌شده: Kavenegar (طبق docs/research/sms-vendor-comparison.md)
# برای پروداکشن SMS_PROVIDER=kavenegar را ست کنید و SMS_API_KEY/SMS_SENDER را از پنل Kavenegar بگیرید.
SMS_PROVIDER=mock          # mock (توسعه) | kavenegar (پیش‌فرض پروداکشن) | ippanel (fallback)
SMS_API_KEY=
SMS_SENDER=

# صف پردازش (ایشو #6)
QUEUE_POLL_INTERVAL_MS=2000

# دستیار RAG (ایشو #28) — از همان MODEL_PROVIDER بالا برای تولید پاسخ استفاده می‌کند؛
# فقط در صورت نیاز به پایگاه دانش سفارشی خارج از src/knowledge/ مقداردهی کنید.
RAG_KNOWLEDGE_DIR=

PORT=3000
NODE_ENV=development
