# Copy to .env beside compose.yaml, fill in real values, and never commit it.
# DATABASE_URL must use the compose database host "db"; percent-encode special
# characters in the password (for example @ becomes %40).
POSTGRES_PASSWORD=
DATABASE_URL=postgres://tabibyar:CHANGE_ME@db:5432/tabibyar
JWT_SECRET=
ENCRYPTION_KEY=
APP_PORT=3000
STT_PROVIDER=mock
